        <mxCell id="config" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;ChunkerConfig&lt;/b&gt;&lt;br&gt;[Java / Jackson]&lt;br&gt;&lt;i&gt;sourceField, chunkSize, chunkOverlap,&lt;br&gt;algorithm, preserveUrls, cleanText&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="overlap" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OverlapChunker&lt;/b&gt;&lt;br&gt;[Java / OpenNLP]&lt;br&gt;&lt;i&gt;Core chunking engine — dispatches&lt;br&gt;to algorithm-specific methods&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="260" height="90" as="geometry"/></mxCell>
