  <diagram id="s3-connector" name="1 - S3 Connector [Component]">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="boundary" value="&lt;b&gt;Container: S3 Connector&lt;/b&gt;&lt;br&gt;[Fargate Service: Java / Quarkus / gRPC]&lt;br&gt;&lt;i&gt;Crawls external S3 buckets and emits discovery events to Kafka&lt;/i&gt;" style="rounded=1;html=1;fillColor=none;strokeColor=#438DD5;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="880" height="640" as="geometry"/></mxCell>
        <mxCell id="grpc_ctrl" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;S3ConnectorControlService&lt;/b&gt;&lt;br&gt;[gRPC Service]&lt;br&gt;&lt;i&gt;Exposes StartCrawl and TestBucketCrawl RPCs&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="160" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="crawl_svc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;S3CrawlService&lt;/b&gt;&lt;br&gt;[Java]&lt;br&gt;&lt;i&gt;Bucket pagination engine using&lt;br&gt;ListObjectsV2 with continuation tokens&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="ds_config" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DatasourceConfigService&lt;/b&gt;&lt;br&gt;[Java / Hibernate Reactive]&lt;br&gt;&lt;i&gt;Per-datasource configuration&lt;br&gt;persistence and cache&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="client_factory" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;S3ClientFactory&lt;/b&gt;&lt;br&gt;[AWS SDK v2]&lt;br&gt;&lt;i&gt;Per-datasource S3 client pool&lt;br&gt;with ConcurrentHashMap cache&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="kms" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;KmsService&lt;/b&gt;&lt;br&gt;[Java]&lt;br&gt;&lt;i&gt;Resolves kms:// credential&lt;br&gt;references to secrets&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="publisher" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;S3CrawlEventPublisher&lt;/b&gt;&lt;br&gt;[Kafka Producer]&lt;br&gt;&lt;i&gt;SHA-256 event ID generation,&lt;br&gt;publishes per-object discovery events&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="450" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="crawl_state" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;CrawlStateService&lt;/b&gt;&lt;br&gt;[Java / Hibernate Reactive]&lt;br&gt;&lt;i&gt;Tracks crawl progress&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="450" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="ext_s3" value="&lt;b&gt;«External System»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Customer S3 Bucket&lt;/b&gt;&lt;br&gt;&lt;i&gt;Source documents&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="170" height="70" as="geometry"/></mxCell>
