        <mxCell id="bulk" value="&lt;b&gt;OpenSearchRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bulk index via gRPC&lt;br&gt;to OpenSearch Manager&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="os_doc" value="&lt;b&gt;OpenSearchDocument (Proto)&lt;/b&gt;&lt;br&gt;&lt;i&gt;original_doc_id, title, body, tags&lt;br&gt;embeddings[]: vector, source_text,&lt;br&gt;chunk_config_id, embedding_id, is_primary&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="os_mgr" value="&lt;b&gt;OpenSearch Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;(external service)&lt;br&gt;EnsureNestedEmbeddingsFieldExists&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="opensearch" value="&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br&gt;&lt;i&gt;k-NN nested embeddings&lt;br&gt;HNSW / cosine similarity&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="engine" target="grpc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc" target="converter" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc" target="schema_mgr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="Ensure index + mapping" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="converter" target="os_doc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="Build document" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="converter" target="bulk" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="prepareBulkRequest" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_mgr" target="os_mgr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="gRPC: EnsureNestedEmbeddingsFieldExists" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="bulk" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7l" value="Bulk index" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="os_mgr" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8l" value="Create index + mapping" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="os-manager" name="7 - OpenSearch Manager">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;OpenSearch Manager — Internal Components&lt;/b&gt;&lt;br&gt;Index lifecycle, dynamic vector field creation, and entity indexing" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="boundary" value="" style="rounded=1;fillColor=none;strokeColor=#438DD5;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="900" height="560" as="geometry"/></mxCell>
        <mxCell id="bl" value="&lt;b&gt;opensearch-manager [Fargate]&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#438DD5;" vertex="1" parent="1"><mxGeometry x="260" y="85" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="sink_caller" value="&lt;b&gt;OpenSearch Sink&lt;/b&gt;&lt;br&gt;&lt;i&gt;(gRPC caller)&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="kafka_in" value="&lt;b&gt;Kafka Topics&lt;/b&gt;&lt;br&gt;&lt;i&gt;drive / node / module /&lt;br&gt;pipedoc / graph-updates&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="grpc_svc" value="&lt;b&gt;OpenSearchManagerService&lt;/b&gt;&lt;br&gt;&lt;i&gt;gRPC API&lt;br&gt;EnsureNestedEmbeddingsFieldExists&lt;br&gt;IndexDocument&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="300" height="75" as="geometry"/></mxCell>
        <mxCell id="resolver" value="&lt;b&gt;EmbeddingBindingResolver&lt;/b&gt;&lt;br&gt;&lt;i&gt;DB lookup: IndexEmbeddingBinding&lt;br&gt;→ EmbeddingModelConfig.dimensions&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="schema_svc" value="&lt;b&gt;OpenSearchSchemaServiceImpl&lt;/b&gt;&lt;br&gt;&lt;i&gt;nestedMappingExists()&lt;br&gt;createIndexWithNestedMapping()&lt;br&gt;Retry 6x with exponential backoff&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="knn_builder" value="&lt;b&gt;KnnVectorProperty Builder&lt;/b&gt;&lt;br&gt;&lt;i&gt;dimension, HNSW algorithm,&lt;br&gt;cosinesimil space, Lucene engine,&lt;br&gt;m / ef_construction / ef_search params&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="indexing_svc" value="&lt;b&gt;OpenSearchIndexingService&lt;/b&gt;&lt;br&gt;&lt;i&gt;Kafka consumer&lt;br&gt;indexDrive / indexNode / indexModule&lt;br&gt;indexPipeDoc / indexGraph&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="280" height="75" as="geometry"/></mxCell>
        <mxCell id="pg_binding" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;IndexEmbeddingBinding&lt;br&gt;EmbeddingModelConfig&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="opensearch" value="&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br&gt;&lt;i&gt;Managed cluster&lt;br&gt;k-NN enabled, nested mappings&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="sink_caller" target="grpc_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc_svc" target="resolver" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="Resolve dimension" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc_svc" target="schema_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="Check/create mapping" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_svc" target="knn_builder" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="Build KNN mapping" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_svc" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="indices.create() / getMapping()" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="resolver" target="pg_binding" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="findByIndexAndField()" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="kafka_in" target="indexing_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="indexing_svc" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8l" value="Index entities" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="embedding-chain" name="8 - Embedding Management Chain">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Automatic Embedding Management — End-to-End Chain&lt;/b&gt;&lt;br&gt;From chunked text through vector generation to auto-provisioned OpenSearch k-NN indices" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="step1" value="&lt;b&gt;1. Chunker&lt;/b&gt;&lt;br&gt;&lt;i&gt;Produces SemanticProcessingResult&lt;br&gt;with chunk_config_id + SemanticChunk[]&lt;br&gt;(text only — no vectors yet)&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="step2" value="&lt;b&gt;2. Embedder&lt;/b&gt;&lt;br&gt;&lt;i&gt;For each SemanticChunk:&lt;br&gt;Extract text_content → DJL batch inference&lt;br&gt;→ Write float[] into ChunkEmbedding.vector&lt;br&gt;Tags with embedding_config_id&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="djl" value="&lt;b&gt;DJL Serving&lt;/b&gt;&lt;br&gt;&lt;i&gt;GPU inference&lt;br&gt;Returns float[][]&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="step3" value="&lt;b&gt;3. OpenSearch Sink — DocumentConverterService&lt;/b&gt;&lt;br&gt;&lt;i&gt;extractAllEmbeddings():&lt;br&gt;Walk PipeDoc.search_metadata.semantic_results[]&lt;br&gt;→ For each result → each chunk → extract embedding&lt;br&gt;→ Dedup by (chunkConfigId | embeddingId | textHash)&lt;br&gt;→ Build OpenSearchEmbedding[] with vector, source_text,&lt;br&gt;    chunk_config_id, embedding_id, is_primary&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="step4" value="&lt;b&gt;4. OpenSearch Sink — SchemaManagerService&lt;/b&gt;&lt;br&gt;&lt;i&gt;ensureIndexExists(&quot;pipeline-{docType}&quot;):&lt;br&gt;① Try gRPC → OpenSearch Manager&lt;br&gt;② Fallback: derive dimension from first vector.size()&lt;br&gt;③ Create index with nested &quot;embeddings&quot; mapping&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="step5" value="&lt;b&gt;5. OpenSearch Manager — EnsureNestedEmbeddingsFieldExists&lt;/b&gt;&lt;br&gt;&lt;i&gt;Dimension resolution hierarchy:&lt;br&gt;① Explicit VectorFieldDefinition (if provided)&lt;br&gt;② EmbeddingBindingResolver → DB lookup&lt;br&gt;   (IndexEmbeddingBinding → EmbeddingModelConfig.dimensions)&lt;br&gt;③ Fallback to caller-provided dimension&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="step6" value="&lt;b&gt;6. OpenSearch Manager — OpenSearchSchemaService&lt;/b&gt;&lt;br&gt;&lt;i&gt;nestedMappingExists()?&lt;br&gt;├ Yes → return (skip creation)&lt;br&gt;└ No → createIndexWithNestedMapping():&lt;br&gt;    KnnVectorProperty(dim, HNSW, cosinesimil, Lucene)&lt;br&gt;    Nested: vector, source_text, chunk_config_id,&lt;br&gt;    embedding_id, is_primary&lt;br&gt;    Retry 6× with backoff&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="310" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="step7" value="&lt;b&gt;7. Bulk Index&lt;/b&gt;&lt;br&gt;&lt;i&gt;OpenSearchDocument serialized to JSON&lt;br&gt;Sent via BulkRequest to OpenSearch&lt;/i&gt;" style="rounded=1;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="opensearch" value="&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nested k-NN index&lt;br&gt;HNSW / cosinesimil / Lucene&lt;br&gt;Queryable by vector, text, config IDs&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="940" y="220" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;IndexEmbeddingBinding&lt;br&gt;EmbeddingModelConfig&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="step1" target="step2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="SemanticChunk[] (text only)" style="edgeLabel;html=1;fontSize=10;fontColor=#2E7D32;" vertex="1" connectable="0" parent="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step2" target="djl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="Batch inference" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="step2" target="step3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="PipeDoc with text + vectors" style="edgeLabel;html=1;fontSize=10;fontColor=#2E7D32;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="step3" target="step4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="OpenSearchDocument + embeddings[]" style="edgeLabel;html=1;fontSize=10;fontColor=#2E7D32;" vertex="1" connectable="0" parent="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step4" target="step5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="gRPC: EnsureNestedEmbeddingsFieldExists" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step5" target="step6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="VectorFieldDefinition (dimension resolved)" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step6" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7l" value="indices.create()" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="step3" target="step7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8l" value="After schema ensured" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step7" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9l" value="BulkRequest" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="step5" target="pg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10l" value="DB lookup" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="e10"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>