        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc" target="factory" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:9px&quot;&gt;createVectorizer(model)&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="factory" target="vectorizer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="vectorizer" target="djl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="&lt;font style=&quot;font-size:9px&quot;&gt;POST /predictions/{model} [HTTPS]&lt;br&gt;{&quot;inputs&quot;: [&quot;text1&quot;, ...]} → float[][]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="vectorizer" target="attach" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="&lt;font style=&quot;font-size:9px&quot;&gt;float[][] vectors&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="os-sink" name="6 - OpenSearch Sink [Component]">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="boundary" value="&lt;b&gt;Container: OpenSearch Sink&lt;/b&gt;&lt;br&gt;[Fargate Service: Java / Quarkus / gRPC]&lt;br&gt;&lt;i&gt;Converts PipeDoc to OpenSearch documents with automatic schema management&lt;/i&gt;" style="rounded=1;html=1;fillColor=none;strokeColor=#438DD5;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="850" height="600" as="geometry"/></mxCell>
        <mxCell id="grpc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchIngestionServiceImpl&lt;/b&gt;&lt;br&gt;[gRPC PipeStepProcessorService]&lt;br&gt;&lt;i&gt;Entry point — coordinates schema&lt;br&gt;management and document conversion&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="converter" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DocumentConverterService&lt;/b&gt;&lt;br&gt;[Java / Protobuf]&lt;br&gt;&lt;i&gt;PipeDoc → OpenSearchDocument.&lt;br&gt;extractAllEmbeddings() deduplicates by&lt;br&gt;chunkConfigId|embeddingId|textHash&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="schema_mgr" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SchemaManagerService&lt;/b&gt;&lt;br&gt;[Java]&lt;br&gt;&lt;i&gt;ensureIndexExists(&quot;pipeline-{docType}&quot;).&lt;br&gt;Primary: delegates to OpenSearch Manager.&lt;br&gt;Fallback: derives dimension from doc vector.size()&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="bulk" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchRepository&lt;/b&gt;&lt;br&gt;[gRPC Client]&lt;br&gt;&lt;i&gt;Executes BulkRequest via gRPC&lt;br&gt;to OpenSearch Manager&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="450" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="os_doc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchDocument&lt;/b&gt;&lt;br&gt;[Protobuf]&lt;br&gt;&lt;i&gt;original_doc_id, title, body, tags,&lt;br&gt;embeddings[]: vector, source_text,&lt;br&gt;chunk_config_id, embedding_id, is_primary&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="310" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="engine_caller" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;PipeDoc with embeddings&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="os_mgr" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearch Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;Index lifecycle + schema creation&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="opensearch" value="&lt;b&gt;«Container: Search Engine»&lt;/b&gt;&lt;br&gt;&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br&gt;&lt;i&gt;k-NN nested embeddings&lt;br&gt;HNSW / cosine similarity&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="engine_caller" target="grpc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="&lt;font style=&quot;font-size:9px&quot;&gt;processData [gRPC]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc" target="converter" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Convert + extract embeddings&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc" target="schema_mgr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Ensure index + mapping&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="converter" target="os_doc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Build OpenSearchDocument&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="converter" target="bulk" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="&lt;font style=&quot;font-size:9px&quot;&gt;prepareBulkRequest&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_mgr" target="os_mgr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="&lt;font style=&quot;font-size:9px&quot;&gt;EnsureNestedEmbeddingsFieldExists [gRPC]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="bulk" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Bulk index [HTTPS]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="os-manager" name="7 - OpenSearch Manager [Component]">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="boundary" value="&lt;b&gt;Container: OpenSearch Manager&lt;/b&gt;&lt;br&gt;[Fargate Service: Java / Quarkus / gRPC]&lt;br&gt;&lt;i&gt;Index lifecycle management, dynamic k-NN vector field creation, entity indexing&lt;/i&gt;" style="rounded=1;html=1;fillColor=none;strokeColor=#438DD5;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="900" height="620" as="geometry"/></mxCell>
        <mxCell id="grpc_svc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchManagerService&lt;/b&gt;&lt;br&gt;[gRPC Service]&lt;br&gt;&lt;i&gt;EnsureNestedEmbeddingsFieldExists,&lt;br&gt;IndexDocument, IndexAnyDocument RPCs&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="resolver" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;EmbeddingBindingResolver&lt;/b&gt;&lt;br&gt;[Java / Hibernate Reactive]&lt;br&gt;&lt;i&gt;DB lookup: IndexEmbeddingBinding&lt;br&gt;→ EmbeddingModelConfig.dimensions.&lt;br&gt;Returns VectorFieldDefinition&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="schema_svc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchSchemaServiceImpl&lt;/b&gt;&lt;br&gt;[OpenSearch Java Client]&lt;br&gt;&lt;i&gt;nestedMappingExists() / createIndexWithNestedMapping().&lt;br&gt;Retry 6× with exponential backoff (250ms base)&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="knn_builder" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;KnnVectorProperty Builder&lt;/b&gt;&lt;br&gt;[OpenSearch Java Client]&lt;br&gt;&lt;i&gt;dimension=N, method=HNSW,&lt;br&gt;engine=Lucene, space=cosinesimil.&lt;br&gt;Configurable m, ef_construction, ef_search&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="710" y="300" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="indexing_svc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearchIndexingService&lt;/b&gt;&lt;br&gt;[Kafka Consumer]&lt;br&gt;&lt;i&gt;Consumes drive / node / module /&lt;br&gt;pipedoc / graph-updates topics.&lt;br&gt;Indexes entities to OpenSearch&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="460" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="initializer" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;IndexInitializer&lt;/b&gt;&lt;br&gt;[Java / @Startup]&lt;br&gt;&lt;i&gt;Creates system indices at boot:&lt;br&gt;repository-pipedocs, filesystem-nodes,&lt;br&gt;filesystem-drives&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="660" y="460" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="sink_caller" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearch Sink&lt;/b&gt;&lt;br&gt;&lt;i&gt;gRPC caller&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="kafka_in" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;AWS MSK&lt;/b&gt;&lt;br&gt;&lt;i&gt;Entity event topics&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;«Container: Database»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;IndexEmbeddingBinding,&lt;br&gt;EmbeddingModelConfig&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="opensearch" value="&lt;b&gt;«Container: Search Engine»&lt;/b&gt;&lt;br&gt;&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br&gt;&lt;i&gt;Managed cluster, k-NN enabled&lt;/i&gt;" style="shape=cylinder3;html=1;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=10;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="sink_caller" target="grpc_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="&lt;font style=&quot;font-size:9px&quot;&gt;EnsureNestedEmbeddingsFieldExists [gRPC]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc_svc" target="resolver" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Resolve dimension&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="grpc_svc" target="schema_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Check / create mapping&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_svc" target="knn_builder" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Build KNN mapping&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="schema_svc" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="&lt;font style=&quot;font-size:9px&quot;&gt;indices.create() / getMapping() [HTTPS]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="resolver" target="pg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6l" value="&lt;font style=&quot;font-size:9px&quot;&gt;findByIndexAndField() [JDBC/mTLS]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="kafka_in" target="indexing_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Entity events [Protobuf/mTLS]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="indexing_svc" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Index entities [HTTPS]&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="initializer" target="opensearch" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9l" value="&lt;font style=&quot;font-size:9px&quot;&gt;Create system indices at startup&lt;/font&gt;" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e9"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="embedding-chain" name="8 - Embedding Management Chain [C4 Dynamic]">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;C4 Dynamic Diagram: Automatic Embedding Management Chain&lt;/b&gt;&lt;br&gt;Shows the runtime interaction sequence from chunked text through auto-provisioned k-NN indices" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="chunker" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Module Chunker&lt;/b&gt;&lt;br&gt;[Fargate: Java / gRPC]&lt;br&gt;&lt;i&gt;Splits text into SemanticChunks&lt;br&gt;with text_content (no vectors)&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="embedder" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Module Embedder&lt;/b&gt;&lt;br&gt;[Fargate: Java / gRPC]&lt;br&gt;&lt;i&gt;Batch-vectorizes chunk texts via DJL.&lt;br&gt;Writes float[] into ChunkEmbedding.vector&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="djl" value="&lt;b&gt;«External System»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DJL Serving&lt;/b&gt;&lt;br&gt;[EC2 GPU + ASG]&lt;br&gt;&lt;i&gt;ML model inference&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="sink" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearch Sink&lt;/b&gt;&lt;br&gt;[Fargate: Java / gRPC]&lt;br&gt;&lt;i&gt;DocumentConverterService extracts +&lt;br&gt;deduplicates embeddings.&lt;br&gt;SchemaManagerService ensures index exists&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="manager" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenSearch Manager&lt;/b&gt;&lt;br&gt;[Fargate: Java / gRPC]&lt;br&gt;&lt;i&gt;EmbeddingBindingResolver resolves dimensions.&lt;br&gt;OpenSearchSchemaService creates k-NN index&lt;br&gt;with HNSW/cosinesimil/Lucene nested mapping&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="310" width="350" height="100" as="geometry"/></mxCell>
