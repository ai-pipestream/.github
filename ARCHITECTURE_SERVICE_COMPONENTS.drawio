        <mxCell id="grpc" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;EmbedderGrpcImpl&lt;/b&gt;&lt;br&gt;[gRPC PipeStepProcessorService]&lt;br&gt;&lt;i&gt;Entry point — iterates SemanticProcessingResults,&lt;br&gt;batches chunk texts, orchestrates vectorization&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="config" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;EmbedderOptions&lt;/b&gt;&lt;br&gt;[Java / Jackson]&lt;br&gt;&lt;i&gt;embeddingModels, checkChunks,&lt;br&gt;djlServingUrl, maxBatchSize (32)&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;VectorizerFactory&lt;/b&gt;&lt;br&gt;[Java]&lt;br&gt;&lt;i&gt;Creates and caches DjlServingVectorizer&lt;br&gt;instances by url+modelName key&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="vectorizer" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DjlServingVectorizer&lt;/b&gt;&lt;br&gt;[Java / HTTP Client]&lt;br&gt;&lt;i&gt;POSTs to /predictions/{model}&lt;br&gt;Parses nested/OpenAI response formats&lt;br&gt;Returns List&amp;lt;float[]&amp;gt;&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="290" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="attach" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Vector Attachment&lt;/b&gt;&lt;br&gt;[Java / Protobuf]&lt;br&gt;&lt;i&gt;Writes float[] into ChunkEmbedding.vector,&lt;br&gt;stamps embedding_config_id + result_set_name&lt;/i&gt;" style="rounded=1;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="engine_caller" value="&lt;b&gt;«Container»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;PipeDoc with SemanticChunks&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="djl" value="&lt;b&gt;«External System»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DJL Serving&lt;/b&gt;&lt;br&gt;[EC2 GPU + ASG]&lt;br&gt;&lt;i&gt;MiniLM / BGE / custom models&lt;br&gt;SSL terminated at ALB&lt;/i&gt;" style="rounded=1;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" source="engine_caller" target="grpc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
