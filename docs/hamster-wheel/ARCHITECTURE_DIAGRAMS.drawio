        <mxGeometry x="40" y="290" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -->
      <mxCell id="p7-sidecar" value="&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Consumes &amp;amp; produces&lt;br&gt;on behalf of Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="480" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Engine -->
      <mxCell id="p7-engine" value="&lt;b&gt;Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;DAG execution,&lt;br&gt;module orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="660" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Repository Service -->
      <mxCell id="p7-repo" value="&lt;b&gt;Repository Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;PipeDoc CRUD,&lt;br&gt;event sourcing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="850" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Account Service -->
      <mxCell id="p7-acct" value="&lt;b&gt;Account Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Tenant, user,&lt;br&gt;permission mgmt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="1200" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- OpenSearch Manager (right side) -->
      <mxCell id="p7-osmgr" value="&lt;b&gt;OpenSearch Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Index management,&lt;br&gt;projection builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="1500" y="900" width="200" height="100" as="geometry"/>
