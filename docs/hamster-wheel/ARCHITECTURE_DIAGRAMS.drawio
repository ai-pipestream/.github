<mxfile host="app.diagrams.net" agent="Architecture Export" version="24.0.0">
<diagram id="c4-l1-system-context" name="Page 1 - System Context (C4 L1)">
  <mxGraphModel dx="2800" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="title-1" value="&lt;b&gt;System Context Diagram [C4 Level 1]&lt;/b&gt;&lt;br/&gt;Shows the overall system and its interactions with users and external systems" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="700" y="20" width="600" height="50" as="geometry"/>
      </mxCell>

      <!-- ============ PEOPLE ============ -->

      <!-- End Users -->
      <mxCell id="person-enduser" value="&lt;b&gt;&amp;laquo;Person&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;End User&lt;/b&gt;&lt;br/&gt;[Researcher / Analyst]&lt;br/&gt;&lt;br/&gt;Searches documents, views&lt;br/&gt;results, and explores&lt;br/&gt;enriched content" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;verticalAlign=middle;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
        <mxGeometry x="350" y="150" width="220" height="180" as="geometry"/>
      </mxCell>

      <!-- Administrators -->
      <mxCell id="person-admin" value="&lt;b&gt;&amp;laquo;Person&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Administrator&lt;/b&gt;&lt;br/&gt;[Platform Operator]&lt;br/&gt;&lt;br/&gt;Configures connectors,&lt;br/&gt;manages accounts, and&lt;br/&gt;monitors pipeline health" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;verticalAlign=middle;spacingTop=5;spacingBottom=5;" vertex="1" parent="1">
        <mxGeometry x="1430" y="150" width="220" height="180" as="geometry"/>
      </mxCell>

      <!-- ============ SYSTEM UNDER DESIGN ============ -->

      <!-- Platform -->
      <mxCell id="system-platform" value="&lt;b&gt;&amp;laquo;Software System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;[ORG_NAME] Platform&lt;/b&gt;&lt;br/&gt;[Cloud-Native Document Processing]&lt;br/&gt;&lt;br/&gt;Ingests documents from diverse sources,&lt;br/&gt;processes them through modular AI/NLP&lt;br/&gt;pipelines, and makes enriched content&lt;br/&gt;searchable via OpenSearch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=13;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="750" y="500" width="500" height="200" as="geometry"/>
      </mxCell>

      <!-- ============ EXTERNAL SYSTEMS ============ -->

      <!-- External Data Sources -->
      <mxCell id="ext-datasources" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;External Data Sources&lt;/b&gt;&lt;br/&gt;[S3 Buckets, APIs, File Shares]&lt;br/&gt;&lt;br/&gt;Provides raw documents&lt;br/&gt;(PDF, DOCX, HTML, etc.)&lt;br/&gt;for ingestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="50" y="520" width="260" height="160" as="geometry"/>
      </mxCell>

      <!-- Metadata Governance -->
      <mxCell id="ext-metadata" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Metadata Governance&lt;/b&gt;&lt;br/&gt;[Enterprise MDM / Data Catalog]&lt;br/&gt;&lt;br/&gt;Provides and receives governed&lt;br/&gt;metadata and lineage information" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="50" y="820" width="260" height="150" as="geometry"/>
      </mxCell>

      <!-- Okta IdP -->
      <mxCell id="ext-okta" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Okta IdP&lt;/b&gt;&lt;br/&gt;[Identity Provider]&lt;br/&gt;&lt;br/&gt;Authenticates users via OIDC&lt;br/&gt;and provides JWT tokens&lt;br/&gt;for authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1690" y="420" width="260" height="160" as="geometry"/>
      </mxCell>

      <!-- Matomo Analytics -->
      <mxCell id="ext-matomo" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Matomo Analytics&lt;/b&gt;&lt;br/&gt;[Self-hosted Web Analytics]&lt;br/&gt;&lt;br/&gt;Collects usage telemetry&lt;br/&gt;and user behavior analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1690" y="640" width="260" height="150" as="geometry"/>
      </mxCell>

      <!-- AWS Bedrock -->
      <mxCell id="ext-bedrock" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS Bedrock&lt;/b&gt;&lt;br/&gt;[Foundation Models API]&lt;br/&gt;&lt;br/&gt;Provides LLM inference for&lt;br/&gt;summarization and generative&lt;br/&gt;AI capabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1690" y="850" width="260" height="160" as="geometry"/>
      </mxCell>

      <!-- ============ EDGES ============ -->

      <!-- End User -> Platform -->
      <mxCell id="edge-eu-platform" value="Searches and browses&lt;br/&gt;enriched documents&lt;br/&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#08427b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" source="person-enduser" target="system-platform" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Admin -> Platform -->
      <mxCell id="edge-admin-platform" value="Configures connectors,&lt;br/&gt;manages pipelines&lt;br/&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#08427b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" source="person-admin" target="system-platform" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Data Sources -> Platform -->
      <mxCell id="edge-ds-platform" value="Fetches raw documents&lt;br/&gt;[S3 API / HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#666666;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="ext-datasources" target="system-platform" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Platform -> Metadata Governance -->
      <mxCell id="edge-platform-meta" value="Publishes metadata&lt;br/&gt;and lineage events&lt;br/&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#666666;strokeWidth=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="system-platform" target="ext-metadata" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Platform -> Okta -->
      <mxCell id="edge-platform-okta" value="Authenticates users&lt;br/&gt;[OIDC / OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="system-platform" target="ext-okta" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Platform -> Matomo -->
      <mxCell id="edge-platform-matomo" value="Sends usage telemetry&lt;br/&gt;[JavaScript tracker / HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="system-platform" target="ext-matomo" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Platform -> Bedrock -->
      <mxCell id="edge-platform-bedrock" value="Requests LLM inference&lt;br/&gt;[AWS SDK / HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#333333;strokeColor=#CC7000;strokeWidth=2;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="system-platform" target="ext-bedrock" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Legend -->
      <mxCell id="legend-1-border" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;" vertex="1" parent="1">
        <mxGeometry x="50" y="1080" width="500" height="200" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="60" y="1085" width="70" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-person" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073B6F;" vertex="1" parent="1">
        <mxGeometry x="70" y="1120" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-person-lbl" value="Person" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="110" y="1115" width="60" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-system" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;" vertex="1" parent="1">
        <mxGeometry x="70" y="1155" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-system-lbl" value="Software System (under design)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="110" y="1150" width="200" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-ext" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;" vertex="1" parent="1">
        <mxGeometry x="70" y="1190" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-ext-lbl" value="External System" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="110" y="1185" width="110" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-aws" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF8C00;strokeColor=#CC7000;" vertex="1" parent="1">
        <mxGeometry x="70" y="1225" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="legend-1-aws-lbl" value="External System (AWS Managed)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="110" y="1220" width="200" height="30" as="geometry"/>
      </mxCell>

    </root>
  </mxGraphModel>
</diagram>
<diagram id="c4-l2-container" name="Page 2 - Container Diagram (C4 L2)">
  <mxGraphModel dx="4000" dy="5200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4000" pageHeight="5000" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="title-2" value="&lt;b&gt;Container Diagram [C4 Level 2]&lt;/b&gt;&lt;br/&gt;Shows the containers within the [ORG_NAME] Platform and their interactions" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="1200" y="20" width="600" height="50" as="geometry"/>
      </mxCell>

      <!-- ============ SYSTEM BOUNDARY ============ -->
      <mxCell id="sys-boundary" value="&lt;b&gt;&amp;laquo;Software System&amp;raquo;&lt;br/&gt;[ORG_NAME] Platform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3C7FC0;dashed=1;dashPattern=8 4;strokeWidth=2;fontSize=14;fontColor=#3C7FC0;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;arcSize=3;" vertex="1" parent="1">
        <mxGeometry x="200" y="100" width="3600" height="4400" as="geometry"/>
      </mxCell>

      <!-- ============ INFRASTRUCTURE (top row) ============ -->

      <!-- AWS ALB -->
      <mxCell id="infra-alb" value="&lt;b&gt;&amp;laquo;Infrastructure&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS ALB&lt;/b&gt;&lt;br/&gt;[TLS termination]&lt;br/&gt;&lt;br/&gt;Routes external HTTPS traffic&lt;br/&gt;to platform services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;fontColor=#333333;strokeColor=#CCCCCC;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1500" y="180" width="250" height="130" as="geometry"/>
      </mxCell>

      <!-- Consul -->
      <mxCell id="infra-consul" value="&lt;b&gt;&amp;laquo;Infrastructure&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Consul&lt;/b&gt;&lt;br/&gt;[EC2 ASG, 3-node cluster]&lt;br/&gt;&lt;br/&gt;Service discovery and&lt;br/&gt;health checking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;fontColor=#333333;strokeColor=#CCCCCC;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2000" y="180" width="250" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ ROW 1: Ingress + Core Services ============ -->

      <!-- Frontend -->
      <mxCell id="c-frontend" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Frontend&lt;/b&gt;&lt;br/&gt;[Fargate: Node.js/Express/Vue 3]&lt;br/&gt;&lt;br/&gt;Serves SPA and proxies&lt;br/&gt;API requests to backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="400" y="420" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- S3 Connector -->
      <mxCell id="c-s3conn" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;S3 Connector&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Polls S3 buckets for new&lt;br/&gt;objects and emits intake events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="850" y="420" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- Intake Gate -->
      <mxCell id="c-intake" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Intake Gate&lt;/b&gt;&lt;br/&gt;connector-intake-service&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Validates, deduplicates, and&lt;br/&gt;routes inbound documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1300" y="420" width="270" height="140" as="geometry"/>
      </mxCell>

      <!-- Account Service -->
      <mxCell id="c-account" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Account Service&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Manages user accounts,&lt;br/&gt;tenant isolation, and RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1750" y="420" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- Connector Admin -->
      <mxCell id="c-connadmin" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Connector Admin&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;CRUD for connector configs&lt;br/&gt;and scheduling rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2200" y="420" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- Platform Registration -->
      <mxCell id="c-platreg" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Platform Registration&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Registers services, modules,&lt;br/&gt;and pipeline definitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2650" y="420" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ ROW 2: Repository + Engine + Search ============ -->

      <!-- Repository Service -->
      <mxCell id="c-repo" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Repository Service&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Persists document metadata&lt;br/&gt;and binary references (claim-check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="400" y="700" width="270" height="140" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -->
      <mxCell id="c-kafkasc" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Abstracts Kafka producer/consumer&lt;br/&gt;with Protobuf serialization&lt;br/&gt;via Apicurio Registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="850" y="700" width="270" height="150" as="geometry"/>
      </mxCell>

      <!-- PipeStream Engine -->
      <mxCell id="c-engine" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PipeStream Engine&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Orchestrates pipeline DAG&lt;br/&gt;execution and module dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1300" y="700" width="270" height="140" as="geometry"/>
      </mxCell>

      <!-- Search Proxy -->
      <mxCell id="c-searchproxy" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Search Proxy&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Translates search queries and&lt;br/&gt;applies tenant-scoped filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1750" y="700" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- OpenSearch Manager -->
      <mxCell id="c-osmgr" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;OpenSearch Manager&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Manages index lifecycle,&lt;br/&gt;mappings, and templates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2200" y="700" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- Apicurio Registry -->
      <mxCell id="c-apicurio" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Apicurio Registry v3&lt;/b&gt;&lt;br/&gt;[Fargate]&lt;br/&gt;&lt;br/&gt;Schema registry for Protobuf&lt;br/&gt;message validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2650" y="700" width="270" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ ROW 3: PROCESSING MODULES (green) ============ -->

      <!-- Module: Parser -->
      <mxCell id="m-parser" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Parser&lt;/b&gt;&lt;br/&gt;[EC2 GPU / Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Extracts text, tables, and&lt;br/&gt;structure from documents&lt;br/&gt;via Docling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="300" y="1050" width="280" height="150" as="geometry"/>
      </mxCell>

      <!-- Module: Chunker -->
      <mxCell id="m-chunker" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Chunker&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Splits parsed content into&lt;br/&gt;semantic chunks for embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="750" y="1050" width="280" height="140" as="geometry"/>
      </mxCell>

      <!-- Module: Embedder -->
      <mxCell id="m-embedder" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Embedder&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Generates vector embeddings&lt;br/&gt;via DJL Serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1200" y="1050" width="280" height="140" as="geometry"/>
      </mxCell>

      <!-- Module: Summarizer -->
      <mxCell id="m-summarizer" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Summarizer&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Generates summaries via&lt;br/&gt;AWS Bedrock LLMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1650" y="1050" width="280" height="140" as="geometry"/>
      </mxCell>

      <!-- Module: OpenSearch Sink -->
      <mxCell id="m-ossink" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;OpenSearch Sink&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Indexes enriched documents&lt;br/&gt;into OpenSearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="2100" y="1050" width="280" height="140" as="geometry"/>
      </mxCell>

      <!-- ============ ROW 4: GPU / ML SERVING ============ -->

      <!-- DJL Serving -->
      <mxCell id="c-djl" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;DJL Serving&lt;/b&gt;&lt;br/&gt;[EC2 GPU + ASG]&lt;br/&gt;&lt;br/&gt;Serves embedding models&lt;br/&gt;(e.g. BGE, E5) on GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1200" y="1350" width="280" height="130" as="geometry"/>
      </mxCell>

      <!-- Docling Serve -->
      <mxCell id="c-docling" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Docling Serve&lt;/b&gt;&lt;br/&gt;[EC2 GPU + ASG]&lt;br/&gt;&lt;br/&gt;Document parsing service&lt;br/&gt;(IBM Docling) on GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="300" y="1350" width="280" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ ROW 5: DATA STORES (orange cylinders) ============ -->

      <!-- AWS MSK -->
      <mxCell id="ds-msk" value="&lt;b&gt;&amp;laquo;Container: Message Broker&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS MSK&lt;/b&gt;&lt;br/&gt;[6 brokers, RF=2]&lt;br/&gt;&lt;br/&gt;Event backbone for all&lt;br/&gt;inter-module messaging" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="870" y="1620" width="240" height="160" as="geometry"/>
      </mxCell>

      <!-- AWS S3 -->
      <mxCell id="ds-s3" value="&lt;b&gt;&amp;laquo;Container: Database&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS S3&lt;/b&gt;&lt;br/&gt;[SSE-KMS encryption]&lt;br/&gt;&lt;br/&gt;Stores document blobs&lt;br/&gt;and intermediate artifacts" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="300" y="1620" width="240" height="160" as="geometry"/>
      </mxCell>

      <!-- Aurora PostgreSQL -->
      <mxCell id="ds-aurora" value="&lt;b&gt;&amp;laquo;Container: Database&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br/&gt;[Multi-AZ, per-service DBs]&lt;br/&gt;&lt;br/&gt;Relational store for accounts,&lt;br/&gt;connectors, and repository metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="1500" y="1620" width="260" height="160" as="geometry"/>
      </mxCell>

      <!-- AWS OpenSearch -->
      <mxCell id="ds-opensearch" value="&lt;b&gt;&amp;laquo;Container: Search Engine&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br/&gt;[7 shards, 3 replicas]&lt;br/&gt;&lt;br/&gt;Full-text and k-NN vector&lt;br/&gt;search for enriched documents" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="2100" y="1620" width="260" height="160" as="geometry"/>
      </mxCell>

      <!-- AWS Bedrock -->
      <mxCell id="ds-bedrock" value="&lt;b&gt;&amp;laquo;Container: Database&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS Bedrock&lt;/b&gt;&lt;br/&gt;[Foundation models]&lt;br/&gt;&lt;br/&gt;LLM inference for&lt;br/&gt;summarization tasks" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="1650" y="1350" width="240" height="140" as="geometry"/>
      </mxCell>

      <!-- ============ EXTERNAL SYSTEMS (outside boundary) ============ -->

      <!-- Okta IdP -->
      <mxCell id="ext2-okta" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Okta IdP&lt;/b&gt;&lt;br/&gt;[Identity Provider]&lt;br/&gt;&lt;br/&gt;OIDC / OAuth 2.0&lt;br/&gt;authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="3100" y="180" width="230" height="130" as="geometry"/>
      </mxCell>

      <!-- Metadata Governance -->
      <mxCell id="ext2-meta" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Metadata Governance&lt;/b&gt;&lt;br/&gt;[Enterprise MDM]&lt;br/&gt;&lt;br/&gt;Governed metadata&lt;br/&gt;and lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="3100" y="380" width="230" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ KEY EDGES ============ -->

      <!-- ALB -> Frontend -->
      <mxCell id="e-alb-fe" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#666666;strokeWidth=1.5;" edge="1" source="infra-alb" target="c-frontend" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- ALB -> Account Service -->
      <mxCell id="e-alb-acct" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#666666;strokeWidth=1.5;" edge="1" source="infra-alb" target="c-account" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Frontend -> Search Proxy -->
      <mxCell id="e-fe-sp" value="[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-frontend" target="c-searchproxy" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- S3 Connector -> Intake Gate -->
      <mxCell id="e-s3c-intake" value="[Protobuf/mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-s3conn" target="c-intake" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Intake Gate -> Repository Service -->
      <mxCell id="e-intake-repo" value="Path A: persist&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-intake" target="c-repo" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Intake Gate -> Kafka Sidecar -->
      <mxCell id="e-intake-ks" value="Path B: RTF&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#438DD5;strokeWidth=1.5;" edge="1" source="c-intake" target="c-kafkasc" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Repository -> Kafka Sidecar -->
      <mxCell id="e-repo-ks" value="[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-repo" target="c-kafkasc" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -> MSK -->
      <mxCell id="e-ks-msk" value="[Protobuf/mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-kafkasc" target="ds-msk" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -> Apicurio -->
      <mxCell id="e-ks-api" value="Schema lookup&lt;br/&gt;[HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-kafkasc" target="c-apicurio" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> Kafka Sidecar -->
      <mxCell id="e-engine-ks" value="Consumes/produces&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3C7FC0;strokeWidth=1.5;" edge="1" source="c-engine" target="c-kafkasc" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> Parser -->
      <mxCell id="e-engine-parser" value="Dispatch&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#064516;strokeWidth=1.5;" edge="1" source="c-engine" target="m-parser" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> Chunker -->
      <mxCell id="e-engine-chunker" value="Dispatch&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#064516;strokeWidth=1.5;" edge="1" source="c-engine" target="m-chunker" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> Embedder -->
      <mxCell id="e-engine-embedder" value="Dispatch&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#064516;strokeWidth=1.5;" edge="1" source="c-engine" target="m-embedder" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> Summarizer -->
      <mxCell id="e-engine-summarizer" value="Dispatch&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#064516;strokeWidth=1.5;" edge="1" source="c-engine" target="m-summarizer" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Engine -> OS Sink -->
      <mxCell id="e-engine-ossink" value="Dispatch&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#064516;strokeWidth=1.5;" edge="1" source="c-engine" target="m-ossink" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Parser -> Docling -->
      <mxCell id="e-parser-docling" value="[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="m-parser" target="c-docling" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Embedder -> DJL -->
      <mxCell id="e-embedder-djl" value="[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="m-embedder" target="c-djl" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Summarizer -> Bedrock -->
      <mxCell id="e-summ-bedrock" value="[AWS SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="m-summarizer" target="ds-bedrock" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- OS Sink -> OpenSearch -->
      <mxCell id="e-ossink-os" value="Bulk index&lt;br/&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="m-ossink" target="ds-opensearch" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Search Proxy -> OpenSearch -->
      <mxCell id="e-sp-os" value="Query&lt;br/&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-searchproxy" target="ds-opensearch" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- OpenSearch Manager -> OpenSearch -->
      <mxCell id="e-osmgr-os" value="Index mgmt&lt;br/&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-osmgr" target="ds-opensearch" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Repository -> S3 -->
      <mxCell id="e-repo-s3" value="Store/retrieve blobs&lt;br/&gt;[AWS SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-repo" target="ds-s3" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Repository -> Aurora -->
      <mxCell id="e-repo-aurora" value="[JDBC/TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-repo" target="ds-aurora" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Account -> Aurora -->
      <mxCell id="e-acct-aurora" value="[JDBC/TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-account" target="ds-aurora" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- ConnAdmin -> Aurora -->
      <mxCell id="e-ca-aurora" value="[JDBC/TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-connadmin" target="ds-aurora" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Account -> Okta -->
      <mxCell id="e-acct-okta" value="[OIDC/OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#666666;strokeWidth=1.5;" edge="1" source="c-account" target="ext2-okta" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Consul edges -->
      <mxCell id="e-consul-services" value="Service discovery&lt;br/&gt;[HTTP/DNS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CCCCCC;strokeWidth=1.5;dashed=1;" edge="1" source="infra-consul" target="c-engine" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- PlatReg -> Aurora -->
      <mxCell id="e-pr-aurora" value="[JDBC/TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-platreg" target="ds-aurora" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- S3 Connector -> S3 (external source) -->
      <mxCell id="e-s3c-s3" value="Poll objects&lt;br/&gt;[AWS SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC7000;strokeWidth=1.5;" edge="1" source="c-s3conn" target="ds-s3" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- ============ LEGEND ============ -->
      <mxCell id="legend-2-border" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;" vertex="1" parent="1">
        <mxGeometry x="250" y="1920" width="700" height="280" as="geometry"/>
      </mxCell>
      <mxCell id="legend-2-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="260" y="1930" width="70" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l2-svc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;" vertex="1" parent="1">
        <mxGeometry x="270" y="1975" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="l2-svc-lbl" value="Platform Container (Service)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="310" y="1970" width="190" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l2-mod" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#085B1D;strokeColor=#064516;" vertex="1" parent="1">
        <mxGeometry x="270" y="2010" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="l2-mod-lbl" value="Processing Module" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="310" y="2005" width="130" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l2-ds" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF8C00;strokeColor=#CC7000;" vertex="1" parent="1">
        <mxGeometry x="270" y="2045" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="l2-ds-lbl" value="AWS Managed Service / Data Store" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="310" y="2040" width="220" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l2-infra" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#CCCCCC;" vertex="1" parent="1">
        <mxGeometry x="270" y="2080" width="30" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="l2-infra-lbl" value="Infrastructure" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="310" y="2075" width="100" height="30" as="geometry"/>
