<diagram id="page6" name="6 - Engine Node Processing">
  <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="p6-title" value="&lt;b&gt;C4 Dynamic Diagram: Engine Node Processing Sequence&lt;/b&gt;&lt;br&gt;7-step execution within a single DAG node" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="400" y="20" width="800" height="50" as="geometry"/>
      </mxCell>

      <!-- Repository (external data store) -->
      <mxCell id="p6-repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;i&gt;«External: Data Store»&lt;/i&gt;&lt;br&gt;&lt;br&gt;PipeDoc + metadata&lt;br&gt;persistence" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#999999;strokeColor=#666666;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="200" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 1: Hydration -->
      <mxCell id="p6-hydrate" value="&lt;b&gt;1. Hydration&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Fetch L1 (envelope) and&lt;br&gt;L2 (content) from Repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="280" y="160" width="220" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 2: CEL Filter (decision diamond) -->
      <mxCell id="p6-celfilter" value="&lt;b&gt;2. CEL Filter&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Evaluate CEL expression&lt;br&gt;(pass / skip)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="550" y="130" width="220" height="170" as="geometry"/>
      </mxCell>

      <!-- Step 3: Pre-Mapping -->
      <mxCell id="p6-premap" value="&lt;b&gt;3. Pre-Mapping&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Transform input fields&lt;br&gt;to module request schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="830" y="160" width="220" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 4: Module Call -->
      <mxCell id="p6-modcall" value="&lt;b&gt;4. Module Call&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Invoke module via gRPC&lt;br&gt;(timeout + retry policy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="830" y="360" width="220" height="100" as="geometry"/>
      </mxCell>

      <!-- DLQ -->
      <mxCell id="p6-dlq" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container: Queue»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Dead Letter Queue&lt;br&gt;for failed messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CC0000;strokeColor=#990000;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="1150" y="360" width="200" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 5: Post-Mapping -->
      <mxCell id="p6-postmap" value="&lt;b&gt;5. Post-Mapping&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Transform module response&lt;br&gt;back to PipeDoc schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="830" y="540" width="220" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 6: Metadata Update -->
      <mxCell id="p6-meta" value="&lt;b&gt;6. Metadata Update&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Update processing metadata&lt;br&gt;timestamps, status, lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="550" y="540" width="220" height="100" as="geometry"/>
      </mxCell>

      <!-- Step 7: CEL Routing (decision diamond) -->
      <mxCell id="p6-celroute" value="&lt;b&gt;7. CEL Routing&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Evaluate routing expression&lt;br&gt;(next node selection)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="270" y="500" width="230" height="180" as="geometry"/>
      </mxCell>

      <!-- gRPC dispatch -->
      <mxCell id="p6-grpc" value="&lt;b&gt;gRPC Dispatch&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Direct node-to-node&lt;br&gt;(low latency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="80" y="760" width="200" height="90" as="geometry"/>
      </mxCell>

      <!-- Kafka dispatch -->
      <mxCell id="p6-kafka" value="&lt;b&gt;Kafka Dispatch&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Component»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Durable async delivery&lt;br&gt;via pipestream topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="360" y="760" width="200" height="90" as="geometry"/>
      </mxCell>

      <!-- Edges: Step 1 Repo → Hydrate -->
      <mxCell id="p6-e0" value="&lt;b&gt;1&lt;/b&gt; fetch L1/L2" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-repo" target="p6-hydrate">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Hydrate → CEL Filter -->
      <mxCell id="p6-e1" value="&lt;b&gt;2&lt;/b&gt; evaluate" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-hydrate" target="p6-celfilter">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- CEL Filter → Pre-Mapping (pass) -->
      <mxCell id="p6-e2" value="&lt;b&gt;3&lt;/b&gt; pass → pre-map" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-celfilter" target="p6-premap">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- CEL Filter → CEL Routing (skip path) -->
      <mxCell id="p6-e2skip" value="&lt;b&gt;skip&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=2;dashed=1;fontColor=#D6B656;" edge="1" parent="1" source="p6-celfilter" target="p6-celroute">
        <mxGeometry relative="1" as="geometry">
          <Array as="points">
            <mxPoint x="660" y="450"/>
            <mxPoint x="500" y="500"/>
          </Array>
        </mxGeometry>
      </mxCell>

      <!-- Pre-Mapping → Module Call -->
      <mxCell id="p6-e3" value="&lt;b&gt;4&lt;/b&gt; invoke [gRPC]" style="html=1;endArrow=block;endFill=1;strokeColor=#085B1D;strokeWidth=2;fontColor=#085B1D;" edge="1" parent="1" source="p6-premap" target="p6-modcall">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Module Call → DLQ (failure, red dashed) -->
      <mxCell id="p6-e3dlq" value="failure" style="html=1;endArrow=block;endFill=1;strokeColor=#CC0000;strokeWidth=2;dashed=1;fontColor=#CC0000;" edge="1" parent="1" source="p6-modcall" target="p6-dlq">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Module Call → Post-Mapping -->
      <mxCell id="p6-e4" value="&lt;b&gt;5&lt;/b&gt; post-map" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-modcall" target="p6-postmap">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Post-Mapping → Metadata Update -->
      <mxCell id="p6-e5" value="&lt;b&gt;6&lt;/b&gt; update metadata" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-postmap" target="p6-meta">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- Metadata Update → CEL Routing -->
      <mxCell id="p6-e6" value="&lt;b&gt;7&lt;/b&gt; route" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-meta" target="p6-celroute">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- CEL Routing → gRPC dispatch -->
      <mxCell id="p6-e7a" value="gRPC (direct)" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-celroute" target="p6-grpc">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- CEL Routing → Kafka dispatch -->
      <mxCell id="p6-e7b" value="Kafka (durable)" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=2;fontColor=#438DD5;" edge="1" parent="1" source="p6-celroute" target="p6-kafka">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
    </root>
  </mxGraphModel>
</diagram>
<diagram id="page7" name="7 - Kafka Topic Topology">
  <mxGraphModel dx="1622" dy="962" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
    <root>
