<diagram id="c4-dynamic-e2e" name="Page 3 - E2E Data Flow (C4 Dynamic)">
  <mxGraphModel dx="3200" dy="3600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="3400" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="title-3" value="&lt;b&gt;C4 Dynamic Diagram: End-to-End Data Flow&lt;/b&gt;&lt;br/&gt;Shows the document journey from source to searchable index" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="900" y="20" width="600" height="50" as="geometry"/>
      </mxCell>

      <!-- ============ ELEMENTS ============ -->

      <!-- External Data Source -->
      <mxCell id="d-ext-source" value="&lt;b&gt;&amp;laquo;External System&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;External Data Source&lt;/b&gt;&lt;br/&gt;[S3 Bucket]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="100" y="150" width="240" height="100" as="geometry"/>
      </mxCell>

      <!-- S3 Connector -->
      <mxCell id="d-s3conn" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;S3 Connector&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="550" y="150" width="280" height="100" as="geometry"/>
      </mxCell>

      <!-- Intake Gate -->
      <mxCell id="d-intake" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Intake Gate&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1050" y="150" width="280" height="100" as="geometry"/>
      </mxCell>

      <!-- Path Decision -->
      <mxCell id="d-decision" value="&lt;b&gt;Routing&lt;br/&gt;Decision&lt;/b&gt;&lt;br/&gt;Path A or B?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontColor=#333333;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
        <mxGeometry x="1110" y="380" width="160" height="140" as="geometry"/>
      </mxCell>

      <!-- Repository Service (Path A) -->
      <mxCell id="d-repo" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Repository Service&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="550" y="400" width="280" height="100" as="geometry"/>
      </mxCell>

      <!-- S3 blob store -->
      <mxCell id="d-s3" value="&lt;b&gt;&amp;laquo;Container: Database&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS S3&lt;/b&gt;&lt;br/&gt;[SSE-KMS]" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=12;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="150" y="390" width="200" height="120" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -->
      <mxCell id="d-kafkasc" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1050" y="650" width="280" height="100" as="geometry"/>
      </mxCell>

      <!-- MSK -->
      <mxCell id="d-msk" value="&lt;b&gt;&amp;laquo;Container: Message Broker&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS MSK&lt;/b&gt;&lt;br/&gt;[6 brokers, RF=2]" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=12;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="1600" y="640" width="240" height="120" as="geometry"/>
      </mxCell>

      <!-- DLQ -->
      <mxCell id="d-dlq" value="&lt;b&gt;&amp;laquo;Container: Message Broker&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;DLQ Topic&lt;/b&gt;&lt;br/&gt;[AWS MSK]" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CC0000;fontColor=#ffffff;strokeColor=#990000;fontSize=11;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="2200" y="640" width="200" height="120" as="geometry"/>
      </mxCell>

      <!-- PipeStream Engine -->
      <mxCell id="d-engine" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PipeStream Engine&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1050" y="900" width="280" height="100" as="geometry"/>
      </mxCell>

      <!-- Parser -->
      <mxCell id="d-parser" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Parser&lt;/b&gt;&lt;br/&gt;[EC2 GPU / Fargate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="300" y="1150" width="250" height="100" as="geometry"/>
      </mxCell>

      <!-- Chunker -->
      <mxCell id="d-chunker" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Chunker&lt;/b&gt;&lt;br/&gt;[Fargate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="700" y="1150" width="250" height="100" as="geometry"/>
      </mxCell>

      <!-- Embedder -->
      <mxCell id="d-embedder" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Embedder&lt;/b&gt;&lt;br/&gt;[Fargate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1100" y="1150" width="250" height="100" as="geometry"/>
      </mxCell>

      <!-- Summarizer -->
      <mxCell id="d-summarizer" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Summarizer&lt;/b&gt;&lt;br/&gt;[Fargate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1500" y="1150" width="250" height="100" as="geometry"/>
      </mxCell>

      <!-- OpenSearch Sink -->
      <mxCell id="d-ossink" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;OpenSearch Sink&lt;/b&gt;&lt;br/&gt;[Fargate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1900" y="1150" width="250" height="100" as="geometry"/>
      </mxCell>

      <!-- OpenSearch -->
      <mxCell id="d-opensearch" value="&lt;b&gt;&amp;laquo;Container: Search Engine&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;AWS OpenSearch&lt;/b&gt;&lt;br/&gt;[7 shards, 3 replicas]" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=12;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="1900" y="1400" width="250" height="130" as="geometry"/>
      </mxCell>

      <!-- ============ NUMBERED EDGES ============ -->

      <!-- 1. Source -> S3 Connector -->
      <mxCell id="de-1" value="&lt;b&gt;1&lt;/b&gt; Poll for new objects&lt;br/&gt;[S3 API / HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-ext-source" target="d-s3conn" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 2. S3 Connector -> Intake Gate -->
      <mxCell id="de-2" value="&lt;b&gt;2&lt;/b&gt; Submit document envelope&lt;br/&gt;[Protobuf/mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-s3conn" target="d-intake" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 3. Intake -> Decision -->
      <mxCell id="de-3" value="&lt;b&gt;3&lt;/b&gt; Validate &amp;amp; deduplicate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-intake" target="d-decision" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 4a. Decision -> Repository (Path A) -->
      <mxCell id="de-4a" value="&lt;b&gt;4a&lt;/b&gt; Path A: Persist document&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-decision" target="d-repo" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 4a.1 Repository -> S3 -->
      <mxCell id="de-4a1" value="&lt;b&gt;4a.1&lt;/b&gt; Store blob&lt;br/&gt;[AWS SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-repo" target="d-s3" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 4b. Decision -> Kafka Sidecar (Path B: RTF) -->
      <mxCell id="de-4b" value="&lt;b&gt;4b&lt;/b&gt; Path B: RTF in-memory&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#438DD5;strokeWidth=2;" edge="1" source="d-decision" target="d-kafkasc" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 5. Repository -> Kafka Sidecar (Path A continues) -->
      <mxCell id="de-5" value="&lt;b&gt;5&lt;/b&gt; Emit claim-check event&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-repo" target="d-kafkasc" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 6. Kafka Sidecar -> MSK -->
      <mxCell id="de-6" value="&lt;b&gt;6&lt;/b&gt; Produce to topic&lt;br/&gt;[Protobuf/mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-kafkasc" target="d-msk" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- DLQ edge -->
      <mxCell id="de-dlq" value="Error / max retries&lt;br/&gt;exceeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#CC0000;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" source="d-msk" target="d-dlq" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 7. MSK -> Engine (consume) -->
      <mxCell id="de-7" value="&lt;b&gt;7&lt;/b&gt; Consume pipeline event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-msk" target="d-engine" parent="1">
        <mxGeometry relative="1" as="geometry">
          <Array as="points">
            <mxPoint x="1720" y="850"/>
            <mxPoint x="1190" y="850"/>
          </Array>
        </mxGeometry>
      </mxCell>

      <!-- 8. Engine -> Parser -->
      <mxCell id="de-8" value="&lt;b&gt;8&lt;/b&gt; Dispatch parse&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-engine" target="d-parser" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 9. Engine -> Chunker -->
      <mxCell id="de-9" value="&lt;b&gt;9&lt;/b&gt; Dispatch chunk&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-engine" target="d-chunker" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 10. Engine -> Embedder -->
      <mxCell id="de-10" value="&lt;b&gt;10&lt;/b&gt; Dispatch embed&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-engine" target="d-embedder" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 11. Engine -> Summarizer -->
      <mxCell id="de-11" value="&lt;b&gt;11&lt;/b&gt; Dispatch summarize&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-engine" target="d-summarizer" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 12. Engine -> OS Sink -->
      <mxCell id="de-12" value="&lt;b&gt;12&lt;/b&gt; Dispatch index&lt;br/&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-engine" target="d-ossink" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- 13. OS Sink -> OpenSearch -->
      <mxCell id="de-13" value="&lt;b&gt;13&lt;/b&gt; Bulk index enriched document&lt;br/&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2D7600;strokeWidth=2;" edge="1" source="d-ossink" target="d-opensearch" parent="1">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>

      <!-- ============ LEGEND ============ -->
      <mxCell id="legend-3-border" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;" vertex="1" parent="1">
        <mxGeometry x="100" y="1550" width="500" height="200" as="geometry"/>
      </mxCell>
      <mxCell id="legend-3-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="110" y="1555" width="70" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l3-green" value="________" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#2D7600;fontStyle=1;" vertex="1" parent="1">
        <mxGeometry x="120" y="1590" width="80" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="l3-green-lbl" value="Primary happy path (Path A: persistent)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="200" y="1590" width="250" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l3-blue" value="________" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#438DD5;fontStyle=1;" vertex="1" parent="1">
        <mxGeometry x="120" y="1620" width="80" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="l3-blue-lbl" value="RTF path (Path B: in-memory)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="200" y="1620" width="190" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l3-red" value="- - - - - - -" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#CC0000;fontStyle=1;" vertex="1" parent="1">
        <mxGeometry x="120" y="1650" width="80" height="30" as="geometry"/>
      </mxCell>
      <mxCell id="l3-red-lbl" value="DLQ / Error path" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="200" y="1650" width="120" height="30" as="geometry"/>
      </mxCell>

      <mxCell id="l3-num-lbl" value="&lt;b&gt;N&lt;/b&gt; = Interaction step number (C4 Dynamic)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="120" y="1690" width="270" height="30" as="geometry"/>
      </mxCell>

    </root>
  </mxGraphModel>
</diagram>
<diagram id="c4-dynamic-claimcheck" name="Page 4 - Claim-Check and Hydration (C4 Dynamic)">
  <mxGraphModel dx="2800" dy="3200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="3000" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="title-4" value="&lt;b&gt;C4 Dynamic Diagram: Claim-Check Pattern and Two-Level Hydration&lt;/b&gt;&lt;br/&gt;Shows how modules receive lightweight references and hydrate data on demand" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="600" y="20" width="700" height="50" as="geometry"/>
      </mxCell>

      <!-- ============ ELEMENTS ============ -->

      <!-- PipeStream Engine -->
      <mxCell id="h-engine" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PipeStream Engine&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Orchestrates pipeline steps;&lt;br/&gt;dispatches claim-check refs&lt;br/&gt;to modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="200" y="150" width="300" height="160" as="geometry"/>
      </mxCell>

      <!-- Kafka Sidecar -->
      <mxCell id="h-kafkasc" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]&lt;br/&gt;&lt;br/&gt;Serializes/deserializes&lt;br/&gt;Protobuf messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="800" y="150" width="280" height="140" as="geometry"/>
      </mxCell>

      <!-- MSK topic -->
      <mxCell id="h-msk" value="&lt;b&gt;&amp;laquo;Container: Message Broker&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;MSK Topic&lt;/b&gt;&lt;br/&gt;[Claim-check reference only]&lt;br/&gt;&lt;br/&gt;Carries lightweight .pb metadata&lt;br/&gt;(1-50 KB per message)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FF8C00;fontColor=#ffffff;strokeColor=#CC7000;fontSize=12;verticalAlign=middle;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
        <mxGeometry x="1400" y="150" width="280" height="160" as="geometry"/>
      </mxCell>

      <!-- Generic Module -->
      <mxCell id="h-module" value="&lt;b&gt;&amp;laquo;Container: Module&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Processing Module&lt;/b&gt;&lt;br/&gt;[Parser / Chunker / Embedder / ...]&lt;br/&gt;&lt;br/&gt;Receives claim-check ref,&lt;br/&gt;hydrates as needed,&lt;br/&gt;processes, dehydrates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#085B1D;fontColor=#ffffff;strokeColor=#064516;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1000" y="500" width="300" height="160" as="geometry"/>
      </mxCell>

      <!-- Decision Diamond -->
      <mxCell id="h-decision" value="&lt;b&gt;Does module&lt;br/&gt;need blob?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontColor=#333333;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
        <mxGeometry x="1060" y="800" width="180" height="140" as="geometry"/>
      </mxCell>

      <!-- L1 Hydration annotation -->
      <mxCell id="h-l1-note" value="&lt;b&gt;L1 Hydration&lt;/b&gt;&lt;br/&gt;.pb metadata deserialized&lt;br/&gt;from Kafka message&lt;br/&gt;&lt;i&gt;Size: 1-50 KB&lt;/i&gt;&lt;br/&gt;&lt;i&gt;Latency: &amp;lt; 1 ms (already in memory)&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;size=14;" vertex="1" parent="1">
        <mxGeometry x="350" y="530" width="260" height="110" as="geometry"/>
      </mxCell>

      <!-- Repository Service -->
      <mxCell id="h-repo" value="&lt;b&gt;&amp;laquo;Container&amp;raquo;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Repository Service&lt;/b&gt;&lt;br/&gt;[Fargate: Java/Quarkus/gRPC]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
        <mxGeometry x="1550" y="800" width="280" height="100" as="geometry"/>
      </mxCell>

