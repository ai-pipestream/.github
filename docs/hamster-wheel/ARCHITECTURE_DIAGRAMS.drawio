      <mxCell id="l2-dash-lbl" value="&lt;i&gt;Dashed boundary = Software System scope&lt;br/&gt;All edge labels indicate protocol in [brackets]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
