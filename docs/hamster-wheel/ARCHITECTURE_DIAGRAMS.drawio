      <mxCell id="1" parent="0"/>

      <!-- Title -->
      <mxCell id="p7-title" value="&lt;b&gt;Kafka Topic Topology — AWS MSK (6 brokers, RF=2, 30-day retention)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
        <mxGeometry x="400" y="20" width="800" height="40" as="geometry"/>
      </mxCell>

      <!-- MSK boundary -->
      <mxCell id="p7-msk" value="&lt;b&gt;AWS MSK Cluster&lt;/b&gt;&lt;br&gt;6 brokers, RF=2, 30-day retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#CCCCCC;fontColor=#333333;dashed=1;dashPattern=5 5;verticalAlign=top;align=left;spacingTop=5;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="440" y="70" width="920" height="1280" as="geometry"/>
      </mxCell>

