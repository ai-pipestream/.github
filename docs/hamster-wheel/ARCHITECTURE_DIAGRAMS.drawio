      <mxCell id="p7-s3conn" value="&lt;b&gt;S3 Connector&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Container»&lt;/i&gt;&lt;br&gt;&lt;br&gt;Kafka Connect&lt;br&gt;S3 Source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="110" width="180" height="100" as="geometry"/>
      </mxCell>

      <!-- Intake Gate -->
