  <diagram id="fanout" name="5 - Combinatorial Fan-Out">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t5" value="&lt;b&gt;Combinatorial Semantic Fan-Out&lt;/b&gt;&lt;br&gt;2 Chunkers × 3 Embedding Models = 6 Result Sets for A/B Testing" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="fo_parsed" value="&lt;b&gt;Parsed Document&lt;/b&gt;&lt;br&gt;&lt;i&gt;Output from Parser&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="180" height="60" as="geometry"/></mxCell>
