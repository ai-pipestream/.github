        <mxCell id="cce8" value="Yes" style="endArrow=block;endFill=1;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;" edge="1" source="cc_decide" target="cc_l2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
