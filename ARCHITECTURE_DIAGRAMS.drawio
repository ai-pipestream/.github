  <diagram id="claim-check" name="4 - Claim-Check and Hydration">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t4" value="&lt;b&gt;Claim-Check Pattern and Two-Level Hydration&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="cc_intake" value="&lt;b&gt;Intake Gate&lt;/b&gt;&lt;br&gt;&lt;i&gt;Receives document + blob&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_s3w" value="&lt;b&gt;AWS S3&lt;/b&gt;&lt;br&gt;&lt;i&gt;.bin blob storage&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_pgw" value="&lt;b&gt;Aurora PG&lt;/b&gt;&lt;br&gt;&lt;i&gt;.pb metadata&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_kafka" value="&lt;b&gt;Kafka Topic&lt;/b&gt;&lt;br&gt;&lt;i&gt;DocumentReference only&lt;br&gt;(~200 bytes)&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_side" value="&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Receives claim check&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_l1" value="&lt;b&gt;L1 Hydration&lt;/b&gt;&lt;br&gt;&lt;i&gt;Fetch .pb metadata&lt;br&gt;~1–50 KB&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="240" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_pgr" value="&lt;b&gt;Aurora PG&lt;/b&gt;&lt;br&gt;&lt;i&gt;Metadata store&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_decide" value="&lt;b&gt;Parser Node?&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does module&lt;br&gt;need blob?&lt;/i&gt;" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="370" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="cc_l2" value="&lt;b&gt;L2 Hydration&lt;/b&gt;&lt;br&gt;&lt;i&gt;Fetch .bin blob&lt;br&gt;KB – GB&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="400" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_s3r" value="&lt;b&gt;AWS S3&lt;/b&gt;&lt;br&gt;&lt;i&gt;Blob store&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="520" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="cc_eng_l2" value="&lt;b&gt;Engine (L1+L2)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Full blob for Parser&lt;/i&gt;" style="shape=hexagon;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=15;perimeter=hexagonPerimeter2;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="640" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_eng_l1" value="&lt;b&gt;Engine (L1 only)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Metadata only for&lt;br&gt;Chunker / Embedder / Sink&lt;/i&gt;" style="shape=hexagon;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=15;perimeter=hexagonPerimeter2;html=1;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_dehydrate" value="&lt;b&gt;Dehydration&lt;/b&gt;&lt;br&gt;&lt;i&gt;Save snapshot,&lt;br&gt;emit new reference&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="cc_next" value="&lt;b&gt;Next Kafka Topic&lt;/b&gt;&lt;br&gt;&lt;i&gt;New DocumentReference&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="cce1" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="cc_intake" target="cc_s3w" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce1l" value="Store blob" style="edgeLabel;fontSize=9;" vertex="1" connectable="0" parent="cce1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce2" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="cc_intake" target="cc_pgw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce2l" value="Store metadata" style="edgeLabel;fontSize=9;" vertex="1" connectable="0" parent="cce2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce3" style="endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="cc_intake" target="cc_kafka" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce3l" value="Publish ref (~200B)" style="edgeLabel;fontSize=10;fontColor=#2E7D32;fontStyle=1;" vertex="1" connectable="0" parent="cce3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce4" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="cc_kafka" target="cc_side" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce5" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="cc_side" target="cc_l1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cce6" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="cc_l1" target="cc_pgr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
