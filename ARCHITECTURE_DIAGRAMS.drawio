  <diagram id="node-proc" name="6 - Engine Node Processing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t6" value="&lt;b&gt;Engine Node Processing Sequence&lt;/b&gt;&lt;br&gt;7-step execution within a single DAG node" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="np_in" value="&lt;b&gt;PipeStream Arrives&lt;/b&gt;&lt;br&gt;&lt;i&gt;From Kafka Sidecar&lt;br&gt;or gRPC&lt;/i&gt;" style="rounded=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="160" height="65" as="geometry"/></mxCell>
        <mxCell id="np_hyd" value="&lt;b&gt;1. Hydration&lt;/b&gt;&lt;br&gt;&lt;i&gt;L1 (.pb metadata)&lt;br&gt;or L2 (.bin blob)&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="160" height="65" as="geometry"/></mxCell>
        <mxCell id="np_repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;i&gt;S3 + Aurora PG&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=10;html=1;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="np_filt" value="&lt;b&gt;2. CEL Filter&lt;/b&gt;&lt;br&gt;&lt;i&gt;Evaluate conditions;&lt;br&gt;skip if any fail&lt;/i&gt;" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="175" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="np_skip" value="&lt;b&gt;Skipped&lt;/b&gt;&lt;br&gt;&lt;i&gt;Forward unmodified&lt;/i&gt;" style="rounded=1;fillColor=#E8E8E8;strokeColor=#CCCCCC;fontSize=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="120" height="45" as="geometry"/></mxCell>
        <mxCell id="np_pre" value="&lt;b&gt;3. Pre-Mapping&lt;/b&gt;&lt;br&gt;&lt;i&gt;ProcessingMapping[]&lt;br&gt;DIRECT, TRANSFORM, CEL&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="200" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="np_call" value="&lt;b&gt;4. Module Call&lt;/b&gt;&lt;br&gt;&lt;i&gt;gRPC to remote module&lt;br&gt;Retry 3x, exp. backoff&lt;/i&gt;" style="rounded=1;fillColor=#085B1D;strokeColor=#064516;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="340" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="np_dlq" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;&lt;i&gt;Poison → DLQ&lt;br&gt;→ Quarantine&lt;/i&gt;" style="shape=cylinder3;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=8;html=1;" vertex="1" parent="1"><mxGeometry x="950" y="340" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="np_post" value="&lt;b&gt;5. Post-Mapping&lt;/b&gt;&lt;br&gt;&lt;i&gt;Normalize module output&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="470" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="np_meta" value="&lt;b&gt;6. Metadata Update&lt;/b&gt;&lt;br&gt;&lt;i&gt;StepExecutionRecord&lt;br&gt;increment hop_count&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="580" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="np_route" value="&lt;b&gt;7. CEL Routing&lt;/b&gt;&lt;br&gt;&lt;i&gt;Evaluate outgoing&lt;br&gt;edge conditions&lt;/i&gt;" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="710" y="700" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="np_grpc" value="&lt;b&gt;Dispatch (gRPC)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Direct in-memory&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="730" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="np_kafka" value="&lt;b&gt;Dispatch (Kafka)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Durable, cross-cluster&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="950" y="730" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="npe1" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_in" target="np_hyd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe2" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_hyd" target="np_repo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe3" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_hyd" target="np_filt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe4" value="Skip" style="endArrow=block;endFill=1;strokeColor=#999999;fontColor=#999999;fontSize=10;" edge="1" source="np_filt" target="np_skip" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe4b" style="endArrow=block;endFill=1;strokeColor=#999999;dashed=1;" edge="1" source="np_skip" target="np_route" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe5" value="Pass" style="endArrow=block;endFill=1;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;" edge="1" source="np_filt" target="np_pre" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe6" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_pre" target="np_call" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe7" value="Failure" style="endArrow=block;endFill=1;strokeColor=#CC0000;fontColor=#CC0000;dashed=1;fontSize=10;" edge="1" source="np_call" target="np_dlq" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe8" value="Success" style="endArrow=block;endFill=1;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;" edge="1" source="np_call" target="np_post" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe9" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_post" target="np_meta" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe10" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_meta" target="np_route" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe11" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_route" target="np_grpc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="npe12" style="endArrow=block;endFill=1;strokeColor=#666666;" edge="1" source="np_route" target="np_kafka" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kafka-topo" name="7 - Kafka Topic Topology">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t7" value="&lt;b&gt;Kafka Topic Topology&lt;/b&gt;&lt;br&gt;AWS MSK — 6 brokers, RF=2, 30-day retention" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="kt_s3" value="&lt;b&gt;S3 Connector&lt;/b&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="kt_t1" value="&lt;b&gt;s3-crawl-events-out&lt;/b&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=8;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="kt_intake" value="&lt;b&gt;Intake Gate&lt;/b&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="kt_t2" value="&lt;b&gt;intake.&amp;lt;datasource_id&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Per-datasource topic&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=8;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="kt_side" value="&lt;b&gt;Kafka Sidecar&lt;/b&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="kt_eng" value="&lt;b&gt;PipeStream Engine&lt;/b&gt;" style="shape=hexagon;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;size=15;perimeter=hexagonPerimeter2;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="kt_t3" value="&lt;b&gt;pipestream.&amp;lt;cluster&amp;gt;.&amp;lt;node&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Inter-node routing&lt;/i&gt;" style="shape=cylinder3;fillColor=#FF8C00;strokeColor=#CC7000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=8;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="250" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="kt_side2" value="&lt;b&gt;Kafka Sidecar&lt;/b&gt;&lt;br&gt;&lt;i&gt;(routes back)&lt;/i&gt;" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="kt_tdlq" value="&lt;b&gt;pipestream.*.dlq&lt;/b&gt;&lt;br&gt;&lt;i&gt;Dead letter&lt;/i&gt;" style="shape=cylinder3;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;fontSize=10;whiteSpace=wrap;size=8;html=1;" vertex="1" parent="1"><mxGeometry x="740" y="250" width="140" height="55" as="geometry"/></mxCell>
